# 复制为 .env 后填入真实值：cp .env.example .env
# .env 已被 .gitignore 排除，不会进仓库。
# 也可以直接用环境变量传入 —— 环境变量优先级高于 .env。

# ── CF Worker 临时邮箱（唯一必填项）──────────────────────────────
# Worker 的 Admin Token。缺失时 run.py 会在启动阶段直接报错并提示本文件。
IR_WORKER_ADMIN_TOKEN=

# ── 以下均有实测默认值，通常不用改 ───────────────────────────────
# IR_WORKER_BASE=https://<worker>.<your-subdomain>.workers.dev
# IR_WORKER_DOMAIN=<your-mail-domain>
# IR_CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
# IR_CHAT_API_BASE=https://discovery-api.intern-ai.org.cn/v1

# ── 行为旋钮（改动前先读 README「可调环境变量」）─────────────────
# ⚠ 这两项都验证过"调了不会更快"，别当成性能旋钮：
# IR_MICRO_BUDGET=45      # 微移动预算（秒）。调小会稳定落到更慢的验证码通路。
# IR_TYPE_DELAY_LO=45     # 逐字输入按键间隔下限（毫秒）
# IR_TYPE_DELAY_HI=110    # 逐字输入按键间隔上限（毫秒）
# IR_NO_MICRO_MOVE=1      # 关闭微移动 —— 仅对照实验用，生产环境勿开
